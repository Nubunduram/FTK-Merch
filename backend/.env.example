# Base de données (fourni automatiquement par Railway si vous utilisez leur PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# Sécurité — générez une valeur aléatoire longue (ex: openssl rand -base64 48)
JWT_SECRET=REMPLACER_PAR_UNE_VALEUR_SECRETE_LONGUE

# Port — Railway injecte automatiquement $PORT, laissez 3001 en fallback
PORT=3001

# URL du frontend en production (votre domaine Vercel)
FRONTEND_URL=https://votre-app.vercel.app

# Stripe — utilisez les clés LIVE en production (pas sk_test_...)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
